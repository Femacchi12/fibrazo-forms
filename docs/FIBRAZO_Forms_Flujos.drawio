<mxCell id="title" value="FIBRAZO Forms · Convenciones de sincronización" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101412;strokeColor=#00f29a;fontColor=#00f29a;fontStyle=1;fontSize=18;" vertex="1" parent="1"><mxGeometry x="80" y="50" width="560" height="70" as="geometry"/></mxCell>
<mxCell id="s1" value="SECCIÓN&amp;#xa;[section:identificacion]&amp;#xa;Moverla no cambia el formulario. Cambiar el ID sí." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#141a17;strokeColor=#00f29a;fontColor=#f3f7f5;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="100" y="180" width="300" height="110" as="geometry"/></mxCell>
<mxCell id="q1" value="PREGUNTA / CAMPO&amp;#xa;[field:cliente_id]&amp;#xa;El ID técnico debe conservarse al cambiar el texto visible." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#141a17;strokeColor=#6cb5e8;fontColor=#f3f7f5;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="460" y="180" width="320" height="110" as="geometry"/></mxCell>
<mxCell id="d1" value="DECISIÓN&amp;#xa;[decision:incluye_tv]&amp;#xa;Las flechas Sí / No definen saltos y secciones visibles." style="rhombus;whiteSpace=wrap;html=1;fillColor=#171d1a;strokeColor=#ffc85c;fontColor=#f3f7f5;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="850" y="170" width="260" height="130" as="geometry"/></mxCell>
<mxCell id="r1" value="REGLA 1&amp;#xa;Cambiar solo posición, tamaño o color = cambio visual. No modifica el formulario." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101412;strokeColor=#8a9690;fontColor=#ffffff;labelBackgroundColor=#101412;labelBorderColor=#56635d;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="100" y="360" width="430" height="100" as="geometry"/></mxCell>
<mxCell id="r2" value="REGLA 2&amp;#xa;Agregar/eliminar bloque, cambiar ID, opciones, requerido, orden o conexión = cambio funcional." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101412;strokeColor=#8a9690;fontColor=#ffffff;labelBackgroundColor=#101412;labelBorderColor=#56635d;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="570" y="360" width="460" height="100" as="geometry"/></mxCell>
