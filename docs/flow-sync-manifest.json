          "required": true,
          "options": [],
          "showWhen": null
        },
        {
          "key": "motivo_principal",
          "section": "motivo",
          "label": "Motivo por el cual dejó de recargar",
          "type": "select",
          "required": true,
          "options": [
            "Inconformidad con el servicio",
            "Precio",
            "Se pasó a otro operador",
            "TV",
            "Mudanza",
            "No usa / no necesita el servicio",
            "Problemas de recarga / pago",
            "Otro"
