  "offline": {
    "version": "0.4",
    "storage": "IndexedDB",
    "store": "queue",
    "pwa": true,
    "serviceWorker": "/service-worker.js",
    "idempotencyKey": "clientSubmissionId",
    "autoSync": [
      "online",
      "auth-ready",
      "visibility-visible"
    ],
    "manualSync": true,
    "scope": "authenticated-internal-forms",
    "publicFormsOffline": false
  },
  "churnCityDetection": {
    "version": "0.4.1",
    "gpsCityVisible": true,
    "manualOptions": [
      "Sincelejo",
      "Montería"
    ],
    "reverseGeocoder": "BigDataCloud free client-side reverse geocode",
    "vercelFunctionUsage": false,
    "offlineFallback": "Configured cities can be detected locally; other cities require connectivity for name resolution.",
    "auditFields": [
      "location.cityDetected",
      "location.citySource"
    ]
  },
  "formConfiguration": {
    "version": "0.5",
    "baselineAccess": [
      "active admins",
      "@fibrazo.com users"
    ],
    "additiveAccess": [
      "public link",
      "additional domains",
      "specific emails"
    ],
    "settings": [
      "introMessage",
      "completionMessage",
      "collectEmail",
      "shuffleQuestions",
      "showProgress",
      "allowMultipleResponses",
      "rateLimit",
      "maxPhotos",
      "maxPhotoMb"
    ],
    "publicEmailBehavior": "collectEmail=true requires Google sign-in; collectEmail=false stores anonymous response",
    "adminUi": "accordion; one form expanded at a time"
  },
  "accessAdministration": {
    "version": "0.6",
    "globalAdmins": {
      "base": [
        "eduardo@fibrazo.com",
        "fernandoemacchi@gmail.com"
      ],
      "additionalAdmins": "managed in USUARIOS; removable unless base"
    },
    "defaultDomainAccess": false,
    "formAccess": [
      "authorized domains",
      "specific emails",
      "public link"
    ],
    "adminUi": "compact accordion with nested collapsible sections"
  },
  "formLifecycle": {
    "version": "0.7",
    "states": [
      "Activo",
      "Inactivo"
    ],
    "inactiveBehavior": "reject all submissions including admins and public links; hidden from respondent dashboard",
    "adminGrouping": "collapsible active and inactive lists",
    "publicDefault": false
  },
  "typography": {
    "reference": "Dashboard Impacto Social",
    "basePx": 14,
    "sectionTitlePx": 17,
    "labelPx": 12,
