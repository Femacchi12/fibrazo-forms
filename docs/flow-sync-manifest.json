          "title": "Servicio actual",
          "description": "Conoce qué alternativa utiliza hoy y cuánto paga."
        },
        {
          "id": "tv",
          "title": "TV y contenidos",
          "description": "Detalle de la oferta de televisión cuando corresponda."
        },
        {
          "id": "cierre",
          "title": "Cierre de la visita",
          "description": "Registra posibilidad de retorno y observaciones finales."
        }
      ],
      "fields": [
        {
          "key": "coordenadas",
          "section": "identificacion",
          "label": "Ubicación de la visita",
